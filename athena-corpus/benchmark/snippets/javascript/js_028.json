  "codeContext": "function mergeSectionLines(existingLines, newLines) {\n  const seen = new Set(existingLines)\n  const merged = [...existingLines]\n  for (const line of newLines) {\n    if (!seen.has(line)) {\n      merged.push(line)\n      seen.add(line)\n    }\n  }\n  return merged\n}",
