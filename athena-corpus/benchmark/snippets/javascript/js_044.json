  "codeContext": "function colorize(text, color, enabled) {\n  if (!enabled) return text\n  const codes = {\n    red: '31',\n    green: '32',\n    yellow: '33',\n    cyan: '36',\n    gray: '90',\n    bold: '1',\n    dim: '2',\n  }\n  const code = codes[color] || '0'\n  return `\\x1b[${code}m${text}\\x1b[0m`\n}",
