  "codeContext": "def sha256(path: Path) -> str:\n    h = hashlib.sha256()\n    with open(path, \"rb\") as f:\n        for chunk in iter(lambda: f.read(1 << 24), b\"\"):\n            h.update(chunk)\n    return h.hexdigest()",
