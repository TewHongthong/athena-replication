  "codeContext": "export function hashSeed(text: string) {\n  let hash = 2166136261;\n  for (let index = 0; index < text.length; index += 1) {\n    hash ^= text.charCodeAt(index);\n    hash = Math.imul(hash, 16777619);\n  }\n  return (hash >>> 0) / 4294967295;\n}",
